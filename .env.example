# Local PostgreSQL connection. These development credentials are not production secrets.
DATABASE_URL=jdbc:postgresql://localhost:5432/dnd_simulator
DATABASE_USERNAME=dnd
DATABASE_PASSWORD=dnd

# Development only: replace with at least 32 random characters before any deployment.
JWT_SECRET=replace-with-a-long-random-secret

# Browser-visible API URL. Do not use an in-container Docker hostname such as "backend".
VITE_API_URL=http://localhost:8080/api
