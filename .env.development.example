# Development database connection
DATABASE_URL=jdbc:postgresql://db:5432/dnd_simulator
DATABASE_USERNAME=dnd
DATABASE_PASSWORD=dnd

# Development pool settings
DATABASE_POOL_MIN_IDLE=5
DATABASE_POOL_MAX=10
DATABASE_POOL_TIMEOUT=30000

# Development Spring profile
SPRING_PROFILES_ACTIVE=dev

# Development JWT settings
JWT_SECRET=replace-with-at-least-32-random-development-characters
JWT_ACCESS_EXPIRATION_MS=900000
REFRESH_EXPIRATION_MS=1209600000
COOKIE_SECURE=false
COOKIE_SAME_SITE=Strict

# Frontend origin allowed by Spring CORS
CORS_ORIGINS=http://localhost:5173
